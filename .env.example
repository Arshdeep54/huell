# --- Instance ---
# Root domain this instance serves docs under. Projects get <slug>.docs.<ORG_DOMAIN>.
ORG_DOMAIN=example.com
# Full origin the dashboard itself is served at.
DASHBOARD_URL=https://docs.example.com

# --- Auth (Google OAuth) ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${DASHBOARD_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ byte secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- GitHub App ---
# Create at https://github.com/settings/apps/new
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Path to the App's private key .pem, mounted into the container.
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# Set when creating the webhook on the App.
GITHUB_WEBHOOK_SECRET=

# --- Storage ---
# SQLite file and per-project build output both live under this directory.
DATA_DIR=/data
