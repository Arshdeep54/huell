{
  "name": "huell",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @huell/web dev",
    "build:web": "pnpm --filter @huell/web build",
    "db:migrate": "pnpm --filter @huell/db migrate",
    "worker": "pnpm --filter @huell/builder start",
    "typecheck": "pnpm -r --if-present run typecheck"
  }
}
