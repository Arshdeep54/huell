---
interface Props {
	title: string;
}

const { title } = Astro.props as Props;
---

<details class="doc-expandable">
	<summary>{title}</summary>
	<div class="doc-expandable-body">
		<slot />
	</div>
</details>

<style>
	.doc-expandable {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.6rem 0.9rem;
		margin: 1rem 0;
	}
	.doc-expandable summary {
		cursor: pointer;
		font-weight: 500;
		font-size: var(--sl-text-sm);
	}
	.doc-expandable[open] summary {
		margin-bottom: 0.5rem;
	}
	.doc-expandable-body {
		font-size: var(--sl-text-sm);
	}
	.doc-expandable-body :global(> :first-child) {
		margin-top: 0;
	}
	.doc-expandable-body :global(> :last-child) {
		margin-bottom: 0;
	}
</style>
