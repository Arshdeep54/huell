# Tunnel-mode variant of Caddyfile — used when Caddy sits behind an
# outbound tunnel (Cloudflare Tunnel, etc.) that already terminates
# public TLS. Caddy only ever receives plain HTTP from the tunnel, and
# has no ACME path of its own since the server isn't publicly reachable
# — so automatic HTTPS and on-demand TLS are both off here.

{
	auto_https off
}

:80 {
	@dashboard host {$DASHBOARD_HOST}
	handle @dashboard {
		reverse_proxy app:3000
	}

	@docs_dot host *.docs.{$ORG_DOMAIN}
	handle @docs_dot {
		# {http.request.host.labels.N} is indexed from the right (TLD = 0), so a
		# fixed index only happens to work when ORG_DOMAIN itself has exactly one
		# label — wrong for the common case (e.g. "example.com"). Strip the known
		# ".docs.<ORG_DOMAIN>" suffix instead, which is correct regardless of how
		# many labels ORG_DOMAIN has.
		map {host} {project_slug} {
			~^(.+)\.docs\.{$ORG_DOMAIN}$ "${1}"
		}
		root * /srv/sites/{project_slug}
		file_server
		try_files {path} {path}/index.html {path}.html /404.html
	}

	@docs_hyphen header_regexp docs_hyphen Host ^(?P<slug>[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)-docs\.{$ORG_DOMAIN}$
	handle @docs_hyphen {
		root * /srv/sites/{http.regexp.docs_hyphen.slug}
		file_server
		try_files {path} {path}/index.html {path}.html /404.html
	}

	handle {
		respond 404
	}
}
