---
interface Props {
	title?: string;
}

const { title } = Astro.props as Props;
---

<div class="doc-step">
	<div class="doc-step-marker"></div>
	<div class="doc-step-body">
		{title && <p class="doc-step-title">{title}</p>}
		<div class="doc-step-content">
			<slot />
		</div>
	</div>
</div>

<style>
	.doc-step {
		display: flex;
		gap: 1rem;
		padding-bottom: 1.5rem;
		counter-increment: doc-step;
	}
	.doc-step:last-child {
		padding-bottom: 0;
	}
	.doc-step-marker {
		flex: none;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 9999px;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.8rem;
		font-weight: 600;
		position: relative;
	}
	.doc-step-marker::before {
		content: counter(doc-step);
	}
	.doc-step:not(:last-child) .doc-step-marker::after {
		content: '';
		position: absolute;
		top: 100%;
		left: 50%;
		width: 1px;
		height: 1.5rem;
		background: var(--sl-color-gray-5);
		transform: translateX(-50%);
	}
	.doc-step-body {
		flex: 1;
		min-width: 0;
		padding-top: 0.15rem;
	}
	.doc-step-title {
		font-weight: 600;
		margin: 0 0 0.4rem;
	}
	.doc-step-content {
		font-size: var(--sl-text-body);
	}
	.doc-step-content :global(> :first-child) {
		margin-top: 0;
	}
</style>
