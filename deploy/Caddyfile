# Huell's reverse proxy: TLS termination + routing only. All routing logic
# that needs to be correct (which subdomain maps to which project, whether a
# hostname is legitimate) lives in the Next.js app, not here — Caddy just
# proxies the dashboard and serves static files for project docs sites.
{
	on_demand_tls {
		ask http://app:3000/api/caddy/ask-domain
	}
}

# The dashboard itself — plain automatic HTTPS, no on-demand cert needed.
{$DASHBOARD_URL} {
	reverse_proxy app:3000
}

# Every project's docs site: <slug>.docs.<ORG_DOMAIN>. Certificates are
# issued on first visit via on-demand TLS (validated by the ask endpoint
# above), so no wildcard DNS-01 setup or DNS provider plugin is required —
# only that *.docs.<ORG_DOMAIN> already resolves to this server.
*.docs.{$ORG_DOMAIN} {
	tls {
		on_demand
	}
	# {http.request.host.labels.N} is indexed from the right (TLD = 0), so a
	# fixed index only happens to work when ORG_DOMAIN itself has exactly one
	# label — wrong for the common case (e.g. "example.com"). Strip the known
	# ".docs.<ORG_DOMAIN>" suffix instead, which is correct regardless of how
	# many labels ORG_DOMAIN has.
	map {host} {project_slug} {
		~^(.+)\.docs\.{$ORG_DOMAIN}$ "${1}"
	}
	root * /srv/sites/{project_slug}
	file_server
	try_files {path} /404.html
}
