---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import nav from '../../nav.config.json';

const currentPath = Astro.url.pathname.replace(/^\/|\/$/g, '');
const isActiveTab = (tab) => tab.groups.some((group) => group.pages.includes(currentPath));
const firstPage = (tab) => tab.groups[0]?.pages[0] ?? '';
const hasTabs = nav.tabs.length > 1;

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

// The tab row only shows at the md breakpoint (matching its `md:sl-flex` class below),
// so only grow --sl-nav-height there too — everything else that depends on this var
// (fixed header height, sidebar top offset, page top padding) follows automatically.
const navHeightOverrideCss = hasTabs
	? `@media (min-width: 50rem){:root{--sl-nav-height:calc(4rem + 2.75rem);}}`
	: '';
---

<style set:html={navHeightOverrideCss} />

<div class="header-rows">
	<div class="header-row-main">
		<div class="title-wrapper sl-flex">
			<SiteTitle />
		</div>
		<div class="sl-flex print:hidden">
			{shouldRenderSearch && <Search />}
		</div>
		<div class="sl-hidden md:sl-flex print:hidden right-group">
			{
				nav.navLinks?.length > 0 && (
					<div class="huell-nav-links">
						{nav.navLinks.map((link) => (
							<a href={link.href}>{link.label}</a>
						))}
					</div>
				)
			}
			<ThemeSelect />
			<LanguageSelect />
			{
				nav.navPrimary && (
					<a class="huell-nav-primary" href={nav.navPrimary.href}>
						{nav.navPrimary.label}
					</a>
				)
			}
		</div>
	</div>
	{
		hasTabs && (
			<nav class="huell-tabs sl-hidden md:sl-flex" aria-label="Sections">
				{nav.tabs.map((tab) => (
					<a href={`/${firstPage(tab)}/`} aria-current={isActiveTab(tab) ? 'page' : undefined}>
						{tab.label}
					</a>
				))}
			</nav>
		)
	}
</div>

<style>
	@layer starlight.core {
		.header-rows {
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: 0.65rem;
			height: 100%;
		}

		.header-row-main {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.right-group {
			gap: 1rem;
			align-items: center;
		}
	}

	.huell-tabs {
		gap: 0.25rem;
		align-items: center;
		flex-shrink: 0;
	}
	.huell-tabs a {
		padding: 0.4rem 0.85rem;
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		white-space: nowrap;
	}
	.huell-tabs a:hover {
		color: var(--sl-color-white);
	}
	.huell-tabs a[aria-current='page'] {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}

	.huell-nav-links {
		display: flex;
		gap: 1rem;
		align-items: center;
	}
	.huell-nav-links a {
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		white-space: nowrap;
	}
	.huell-nav-links a:hover {
		color: var(--sl-color-white);
	}

	.huell-nav-primary {
		display: inline-flex;
		align-items: center;
		height: 2rem;
		padding: 0 0.9rem;
		border-radius: 999px;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: opacity 150ms ease;
	}
	.huell-nav-primary:hover {
		opacity: 0.85;
		color: var(--sl-color-black);
	}
</style>
